# Legacy configuration (supported for migration). Do not use it in local-only mode.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Generic OpenAI-compatible configuration.
# Uncomment all three lines together. Empty connection values are invalid.
# AMA_LLM_BASE_URL=https://api.deepseek.com/v1
# AMA_LLM_API_KEY=sk-your-provider-key-here
# AMA_LLM_MODEL=deepseek-chat

# Local keyless example. Set AMA_RUNTIME_MODE=local-only as well.
# AMA_RUNTIME_MODE=local-only
# AMA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AMA_LLM_MODEL=your-local-model-name

AMA_RUNTIME_MODE=cloud-allowed
AMA_LLM_TIMEOUT_SECONDS=60
AMA_LLM_STREAMING_ENABLED=true
AMA_LLM_QUOTA_ENABLED=true
AMA_LLM_DAILY_QUOTA=500

AMA_CHROMA_BASE_URL=http://localhost:8000
AMA_CHROMA_COLLECTION=aviation-docs
# Host path used only by Compose volume interpolation.
AMA_CHROMA_DATA_PATH=./backend/chroma-data
AMA_DATA_PATH=./data
AMA_STATE_PATH=./state
AMA_RAG_MAX_RESULTS=5
AMA_RAG_MIN_SCORE=0.6
AMA_AVIATION_QUERY_TRANSLATION_ENABLED=true

AMA_RATE_LIMIT_ENABLED=true
AMA_RATE_LIMIT_PER_IP_PER_HOUR=20
# Enable only behind a controlled proxy when the backend cannot be accessed directly.
AMA_TRUST_PROXY_HEADERS=false
