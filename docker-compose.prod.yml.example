# Copy this template, then provide the production images, certificates, and .env values.
# The backend has no host port mapping. Enable forwarded headers only while that remains true.
services:
  chromadb:
    image: chromadb/chroma:0.5.5
    container_name: ama-chromadb
    volumes:
      - ${AMA_CHROMA_DATA_PATH:-./backend/chroma-data}:/chroma/chroma
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/api/v1/heartbeat"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    restart: unless-stopped
    networks:
      - ama-network

  backend:
    image: ama-backend:1.0.0-20260612
    container_name: ama-backend
    env_file:
      - path: .env
        required: false
    environment:
      AMA_RUNTIME_MODE: ${AMA_RUNTIME_MODE:-cloud-allowed}
      AMA_CHROMA_BASE_URL: http://chromadb:8000
      AMA_CHROMA_COLLECTION: ${AMA_CHROMA_COLLECTION:-aviation-docs}
      AMA_DATA_PATH: /app/data
      AMA_STATE_PATH: /app/state
      AMA_TRUST_PROXY_HEADERS: "true"
    volumes:
      - ./backend/data:/app/data:ro
      - ./backend/state:/app/state
    depends_on:
      chromadb:
        condition: service_healthy
    restart: unless-stopped
    networks:
      - ama-network

  frontend:
    image: ama-frontend:1.0.0-20260612
    container_name: ama-frontend
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./deploy/nginx.prod.conf:/etc/nginx/conf.d/default.conf:ro
      - ./deploy/ssl/cert.crt:/etc/nginx/ssl/cert.crt:ro
      - ./deploy/ssl/cert.key:/etc/nginx/ssl/cert.key:ro
    depends_on:
      - backend
    restart: unless-stopped
    networks:
      - ama-network

networks:
  ama-network:
    driver: bridge
